{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Gateway (Worker)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-worker",
            "program": "${workspaceFolder}/src/OrionHealth.Worker/bin/Debug/net8.0/OrionHealth.Worker.dll",
            "args": [
                "--environment",
                "Development"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Run Hl7Processor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-hl7processor",
            "program": "${workspaceFolder}/src/OrionHealth.Hl7Processor/bin/Debug/net8.0/OrionHealth.Hl7Processor.dll",
            "args": [
                "--environment",
                "Development"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Run Notifier",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-notifier",
            "program": "${workspaceFolder}/src/OrionHealth.Notifier/bin/Debug/net8.0/OrionHealth.Notifier.dll",
            "args": [
                "--environment",
                "Development"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Run TestClient",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-testclient",
            "program": "${workspaceFolder}/test/OrionHealth.TestClient/bin/Debug/net8.0/OrionHealth.TestClient.dll",
            "args": [],
            "cwd": "${workspaceFolder}/test/OrionHealth.TestClient",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Run All Services + Client",
            "configurations": [
                "Run Gateway (Worker)",
                "Run Hl7Processor",
                "Run Notifier",
                "Run TestClient"
            ]
        },
        {
            "name": "Run Gateway + TestClient",
            "configurations": [
                "Run Gateway (Worker)",
                "Run TestClient" 
            ]
        }
    ]
}
